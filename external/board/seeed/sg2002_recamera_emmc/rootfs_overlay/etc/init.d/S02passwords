#!/bin/sh
#
# S02passwords -- put back the passwords changed on the page (A8, 20/10/2026).
# The page login is the system login; a new password goes to /etc/shadow and
# to /data/recamera/passwords ("user:hash" lines), because an A/B update
# rewrites the rootfs with the default /etc/shadow. This copies the kept
# hashes back at every boot. No file: the image defaults stay.

KEPT=/data/recamera/passwords

case "$1" in
	start)
		[ -s "$KEPT" ] || exit 0
		printf "Restoring passwords: "
		n=0
		while IFS=: read -r user hash; do
			case "$hash" in \$*) ;; *) continue ;; esac
			grep -q "^$user:" /etc/shadow || continue
			# the hash has no ':' or newline; '|' is not in crypt's alphabet
			sed -i "s|^$user:[^:]*:|$user:$hash:|" /etc/shadow && n=$((n + 1))
		done < "$KEPT"
		echo "$n"
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start}"; exit 1 ;;
esac
