# F7: SoC temperature sensor (patch 0021), built in so the critical trip and
# the DDR thermal refresh control work from boot
CONFIG_CV181X_THERMAL=y

# A3 (20/10/2026): the kernel log of a hang, kept across the watchdog reset
# (warm reset, the DRAM keeps its content): ramoops region in the board DT,
# read after the next boot in /sys/fs/pstore (console-ramoops-0 = the
# previous boot's log). The soft lockup detector (20 s) reports where the
# kernel is stuck before the hardware watchdog (30 s) resets the board.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# A3 (20/10/2026): a kernel built with another configuration refuses the
# out-of-tree modules (sophgo-ion, sophgo-osdrv, morse-driver) built for the
# previous one, instead of running them with stale struct layouts. Found the
# hard way: CONFIG_DETECT_HUNG_TASK grew struct semaphore (last_holder), the
# old cv181x_vcodec/cvi_vc_driver kept running and their down()/up()
# corrupted the neighbouring statics (Oops in vpu_open_instance, encoder
# semaphores stuck).
CONFIG_MODVERSIONS=y
