BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVC=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_PATH="/opt/riscv64-musl"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-buildroot-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RECAMERA_PATH)/patches"
BR2_CCACHE=y
BR2_CCACHE_DIR="$(BR2_EXTERNAL_RECAMERA_PATH)/../.ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=20G"
BR2_TARGET_GENERIC_HOSTNAME="sg200x"
BR2_TARGET_GENERIC_ISSUE="Welcome to Sg200x"
BR2_TARGET_GENERIC_ROOT_PASSWD="recamera"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/dts"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_RECAMERA_PATH)/board/seeed/sg2002_recamera_emmc/busybox.config"
BR2_PACKAGE_GDB=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BRCM_PATCHRAM_PLUS=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_MORSE_DRIVER=y
BR2_PACKAGE_MORSE_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_S1G=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_UTIL_LINUX_UUIDD=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_FWPRINTENV=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_SHADOW=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="200M"
# 4 KiB blocks: the eMMC slots are resized to 8 GiB (1 KiB is the default for
# small images); ^64bit stays (Buildroot default, old U-Boot ext4 readers)
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -b 4096"
BR2_TARGET_ROOTFS_TAR_XZ=y
# No BR2_TARGET_UBOOT / BR2_TARGET_OPENSBI: the boot chain (FSBL + OpenSBI +
# U-Boot) is the board fip.bin, built by the recamera-fip package from the
# official one. Only host-uboot-tools (mkimage, mkenvimage) is needed here.
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_SOPHGO_ION=y
BR2_PACKAGE_SOPHGO_OSDRV=y
BR2_PACKAGE_SOPHGO_MPI=y
BR2_PACKAGE_SOPHGO_CVIRUNTIME=y
BR2_PACKAGE_RECAMERA_FIP=y
BR2_PACKAGE_RECAMERA_TESTS=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_RECAMERA_APP=y
# A8: time zones (tzdata, the commonly used zones); the zone is chosen on
# the page and kept in /data (/etc/localtime -> /data/recamera/localtime)
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="default"
BR2_TARGET_LOCALTIME="Etc/UTC"
# radio firmware, downloaded from public sources (no binary in the overlay)
BR2_PACKAGE_RECAMERA_FIRMWARE=y
# TLS clients of the app (MQTT over TLS, the LLM endpoint): the CA bundle
BR2_PACKAGE_CA_CERTIFICATES=y
