+		ret = devm_clk_bulk_get_all_enabled(dev, &clks);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "VIP clocks\n");
+		if (ret == 0)
+			dev_warn(dev, "no VIP clocks in DT: vip_sys access may hang\n");
+	}
