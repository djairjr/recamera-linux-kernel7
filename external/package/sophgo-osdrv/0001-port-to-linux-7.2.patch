 	if (!ndev)
 		return -ENOMEM;
 
+	/*
+	 * 7.2 port: enable the VIP clocks before any vip_sys access. The vendor
+	 * clk driver never turned them off (CLK_IS_CRITICAL/IGNORE_UNUSED);
+	 * mainline does at late init, and touching vip_sys then hangs the SoC.
+	 * The clocks are listed in the base DT node.
+	 */
+	{
+		struct clk_bulk_data *clks;
