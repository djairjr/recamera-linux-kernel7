diff --color -ruN a/dot11ah/s1g_compat_new.h b/dot11ah/s1g_compat_new.h
--- a/dot11ah/s1g_compat_new.h	1969-12-31 21:00:00.000000000 -0300
+++ b/dot11ah/s1g_compat_new.h	2026-10-18 14:41:26.010321404 -0300
@@ -0,0 +1,50 @@
+/*
+ * reCamera port (Linux 7.2): S1G compatibility with the reworked mainline S1G.
+ *
+ * Mainline replaced its 5.10-era S1G helpers (include/linux/ieee80211-s1g.h):
+ *  - IEEE80211_CHAN_{1,2,4,8,16}MHZ channel flags were removed.  This driver
+ *    only uses them on its own S1G channel tables (s1g_channels_rules.c), never
+ *    on channels registered with cfg80211, so they are private bits here, with
+ *    the same values the driver already uses for older kernels
+ *    (s1g_ieee80211.h, CHANNEL_FLAGS_BW_MASK 0x7c000).
+ *  - ieee80211_is_s1g_short_beacon(fc) became a 3-argument, content-based
+ *    check, and struct ieee80211_ext lost u.s1g_short_beacon.  The driver's
+ *    notion of a short beacon is the 5.10 one: an S1G beacon with the
+ *    NEXT_TBTT bit, whose elements follow the 3-byte next TBTT field.
+ */
+#pragma once
+
+#if defined(__has_include)
+#if __has_include(<linux/ieee80211-s1g.h>)
+#define MORSE_MAINLINE_S1G_REWORK 1
+#endif
+#endif
+
+#ifdef MORSE_MAINLINE_S1G_REWORK
+#include <linux/ieee80211-s1g.h>
+
+#ifndef IEEE80211_CHAN_1MHZ
+enum morse_dot11ah_private_chan_bw {
+	IEEE80211_CHAN_1MHZ		= BIT(14),
+	IEEE80211_CHAN_2MHZ		= BIT(15),
+	IEEE80211_CHAN_4MHZ		= BIT(16),
+	IEEE80211_CHAN_8MHZ		= BIT(17),
+	IEEE80211_CHAN_16MHZ		= BIT(18),
+};
+#define IEEE80211_CHAN_1MHZ IEEE80211_CHAN_1MHZ
+#endif
+
+static inline bool morse_s1g_short_beacon(__le16 fc)
+{
+	return ieee80211_s1g_has_next_tbtt(fc);
+}
+
+#define MORSE_S1G_NEXT_TBTT_LEN 3
+#define MORSE_S1G_SHORT_BCN_IES(bcn) ((bcn)->u.s1g_beacon.variable + MORSE_S1G_NEXT_TBTT_LEN)
+
+#else
+
+#define morse_s1g_short_beacon(fc) ieee80211_is_s1g_short_beacon(fc)
+#define MORSE_S1G_SHORT_BCN_IES(bcn) ((bcn)->u.s1g_short_beacon.variable)
+
+#endif
